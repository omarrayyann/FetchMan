# Downloaded assets (fetched by molmospaces/scripts/run_download.sh).
# The 5 sample scenes under assets/sample_scenes/ (plus their objects and grasps) are tracked.
molmospaces/assets/scenes/
# objects/ and grasps/ for the sample scenes ARE tracked (see README); the
# sources the downloader adds alongside them are symlinks into a local cache.
molmospaces/assets/objects/objaverse
molmospaces/assets/objects/objathor_metadata
molmospaces/assets/grasps/droid_objaverse
# The downloader also links the rest of thor and droid into these partially
# tracked dirs. Ignoring never untracks a file, so the sample-scene subset stays
# versioned; adding a new tracked asset here takes `git add -f`.
molmospaces/assets/objects/thor/**
molmospaces/assets/grasps/droid/**

molmospaces/assets/.lmdb/

# Generated data
/data*/
logs
MUJOCO_LOG.TXT
download_scenes.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

.DS_Store

# derived grasp-uid cache (regenerated on first run)
molmospaces/assets/grasps/.valid_uids.txt

# verification-harness output (written into the repo root when run)
t_*.json

# training run output
exp/
lightning_logs/
wandb/

# Released policy checkpoints (hf download omarrayyann/fetchman).
checkpoints/
